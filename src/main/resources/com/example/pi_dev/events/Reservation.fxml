<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="900.0" prefWidth="1000.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pi_dev.Controllers.Events.ReservationController">
   <content>
      <VBox alignment="TOP_CENTER" spacing="0.0" style="-fx-background-color: #F8FAFC;">
         <children>
            <!-- Hero Header Section -->
            <StackPane prefHeight="220.0" style="-fx-background-color: #1E293B;">
               <children>
                  <VBox alignment="CENTER" spacing="10.0">
                     <children>
                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" text="📌" />
                              <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Réservation" />
                           </children>
                        </HBox>
                        <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Confirmez vos places pour cet événement exceptionnel" textAlignment="CENTER" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </StackPane>

            <!-- Main Content Container (Overlapping slightly) -->
            <VBox alignment="TOP_CENTER" maxWidth="800.0" spacing="25.0">
               <padding>
                  <Insets bottom="50.0" left="20.0" right="20.0" top="-40.0" />
               </padding>
               <children>
                  
                  <!-- Event Summary Card -->
                  <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 25;">
                     <children>
                        <StackPane prefHeight="60.0" prefWidth="60.0" style="-fx-background-color: #F87171; -fx-background-radius: 12;">
                           <children>
                              <Label style="-fx-font-size: 24px;" text="📍" textFill="WHITE" />
                           </children>
                        </StackPane>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="Eventlieu" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Lac 1" />
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-text-fill: #64748B;" text="📅" />
                                    <Label fx:id="datedebut" style="-fx-text-fill: #64748B;" text="12/05/2026 09:00" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label style="-fx-text-fill: #64748B;" text="👥" />
                                    <Label fx:id="personCountLabel" style="-fx-text-fill: #64748B;" text="15 places disponibles" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                           <children>
                              <Label fx:id="oldPrixlabel" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8; -fx-strikethrough: true;" visible="false" managed="false" text="15.00 TND" />
                              <Label fx:id="prixlabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="10.00 TND" />
                              <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="par personne" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Personal Information Card -->
                  <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 30;">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label style="-fx-text-fill: #1E293B;" text="👤" />
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 15px;" text="Informations personnelles" />
                           </children>
                        </HBox>
                        <Separator />
                        
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Nom complet" />
                              <TextField fx:id="nomField" promptText="Ex: Jean Dupont" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 12;" />
                           </children>
                        </VBox>

                        <HBox spacing="20.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Email" />
                                    <TextField fx:id="emailField" promptText="votre.email@example.com" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 12;" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Téléphone" />
                                    <TextField fx:id="telephoneField" promptText="+216 XX XXX XXX" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 12;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Demandes spéciales (optionnel)" />
                              <TextArea fx:id="demandesp" prefHeight="100.0" promptText="Régimes alimentaires, besoins spécifiques..." style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 12; -fx-wrap-text: true;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Participants Selection Card -->
                  <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 30;">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label style="-fx-text-fill: #1E293B;" text="👥" />
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 15px;" text="Participants" />
                           </children>
                        </HBox>
                        <Separator />

                        <HBox spacing="30.0">
                           <children>
                              <!-- Adults Counter -->
                              <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F1F5F9; -fx-background-radius: 12; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Adultes" />
                                          <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="18 ans et plus" />
                                       </children>
                                    </VBox>
                                    <HBox alignment="CENTER" spacing="15.0">
                                       <children>
                                          <Button onAction="#decrementAdults" style="-fx-background-color: #E2E8F0; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand;" text="−" />
                                          <Label fx:id="nbAdultesLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #EF4444; -fx-min-width: 20;" text="1" textAlignment="CENTER" />
                                          <Button onAction="#incrementAdults" style="-fx-background-color: #E2E8F0; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand;" text="+" />
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>

                              <!-- Children Counter -->
                              <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F1F5F9; -fx-background-radius: 12; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" text="Enfants" />
                                          <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px;" text="Moins de 18 ans" />
                                       </children>
                                    </VBox>
                                    <HBox alignment="CENTER" spacing="15.0">
                                       <children>
                                          <Button onAction="#decrementChildren" style="-fx-background-color: #E2E8F0; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand;" text="−" />
                                          <Label fx:id="nbEnfantsLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #EF4444; -fx-min-width: 20;" text="0" textAlignment="CENTER" />
                                          <Button onAction="#incrementChildren" style="-fx-background-color: #E2E8F0; -fx-background-radius: 50; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand;" text="+" />
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>


                        <!-- Total Banner -->
                        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1E3A5F; -fx-background-radius: 12; -fx-padding: 25;">
                           <children>
                              <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Total à régler" />
                                    <Label fx:id="nbPersonnesTotalLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" text="1 personne" />
                                 </children>
                              </VBox>
                              <Label fx:id="totalLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #4ADE80;" text="10.00 TND" />
                           </children>
                        </HBox>

                        <!-- Action Buttons -->
                        <VBox alignment="CENTER" spacing="15.0">
                           <children>
                              <Button fx:id="reserverButton" maxWidth="Infinity" onAction="#reserver" prefHeight="60.0" style="-fx-background-color: #EF4444; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;" text="Confirmer la réservation ➜" />
                              <Hyperlink onAction="#annulerRES" style="-fx-text-fill: #64748B; -fx-font-size: 14px;" text="⬅ Retour à l'événement" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>
