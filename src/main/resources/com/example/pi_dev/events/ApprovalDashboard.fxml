<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pi_dev.Controllers.Events.ApprovalDashboardController">
   <top>
      <VBox style="-fx-background-color: linear-gradient(to bottom right, #111827, #1D4ED8); -fx-padding: 18 24;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15">
               <children>
                  <VBox spacing="4" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Validation Admin" />
                        <Label fx:id="summaryLabel" style="-fx-font-size: 13px; -fx-text-fill: #D1D5DB;" text="Validation des contenus en attente" />
                     </children>
                  </VBox>
                  <Button onAction="#refreshData" style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 10 18; -fx-cursor: hand;" text="🔄 Actualiser" />
                  <Button onAction="#closeWindow" style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 10 18; -fx-cursor: hand;" text="✕ Fermer" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">
         <tabs>
            <Tab text="Activités en attente">
               <content>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                     <content>
                        <VBox fx:id="activitiesContainer" spacing="14" style="-fx-padding: 18;" />
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
            <Tab text="Événements en attente">
               <content>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                     <content>
                        <VBox fx:id="eventsContainer" spacing="14" style="-fx-padding: 18;" />
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
            <Tab text="Réservations en attente">
               <content>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                     <content>
                        <VBox fx:id="reservationsContainer" spacing="14" style="-fx-padding: 18;" />
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
   </center>
</BorderPane>
