<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox style="-fx-background-color: linear-gradient(to bottom, #CAD4DC, #ffffff); -fx-padding: 0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pi_dev.Controllers.Events.modifierActiviteController">
    <children>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: linear-gradient(to bottom right, #86A7BF, #2D70B3); -fx-padding: 20; -fx-spacing: 20;">
            <children>
                <ImageView fitHeight="50" fitWidth="50">
                    <image>
                        <Image url="@../images/wanderlust-logo.png" />
                    </image>
                </ImageView>
                <VBox spacing="5">
                    <children>
                        <Label fx:id="titleLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Modifier l'activité" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #86A7BF;" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="15">
                    <children>
                        <Button fx:id="catalog" onAction="#goToCatalogue" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: transparent; -fx-border-width: 0 0 2 0; -fx-font-size: 14px; -fx-cursor: hand;" text="🏠 Catalogue" />
                    </children>
                </HBox>
            </children>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="TOP_CENTER" maxWidth="700" style="-fx-padding: 40; -fx-spacing: 25;">
                    <children>
                        <VBox spacing="25" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 8);">
                            <children>
                                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="✨ Modifier l'activité" />
                                <Separator style="-fx-background-color: #e2e8f0;" />

                                <!-- Catégorie -->
                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Catégorie" />
                                        <ComboBox fx:id="categorieCombo" prefHeight="45" prefWidth="320" promptText="Sélectionner une catégorie" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5 10; -fx-font-size: 14px;" />
                                    </children>
                                </VBox>

                                <!-- Type d'activité -->
                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Type d'activité" />
                                        <ComboBox fx:id="typeactField" prefHeight="45" prefWidth="320" promptText="Sélectionner un type" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5 10; -fx-font-size: 14px;" />
                                    </children>
                                </VBox>

                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Titre *" />
                                        <TextField fx:id="titreField" promptText="Titre de l'activité" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                                    </children>
                                </VBox>
                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Description" />
                                        <TextArea fx:id="descriptionArea" prefRowCount="4" promptText="Description..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px;" wrapText="true" />
                                        <HBox alignment="CENTER_RIGHT">
                                            <Button fx:id="enhanceDescBtn" onAction="#enhanceDescription" style="-fx-background-color: linear-gradient(to right, #8b5cf6, #6366f1); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.4), 10, 0, 0, 4);" text="✨ Améliorer avec l'IA" />
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Image de l'activité" />
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="imageField1" promptText="Aucune image sélectionnée" editable="false" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="importImageButton" onAction="#importerImage" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(15,118,110,0.3), 5, 0, 0, 2);" text="📁 Importer" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <!-- Age minimum -->
                                <VBox spacing="8">
                                    <children>
                                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Âge minimum" />
                                        <TextField fx:id="ageMinField" promptText="Âge minimum (laisser vide si aucun)" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                                    <children>
                                        <Button fx:id="modifierButton" onAction="#modifier" style="-fx-background-color: linear-gradient(to right, #2D70B3, #1A4E85); -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 40; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(26,78,133,0.4), 10, 0, 0, 4);" text="💾 Modifier" />
                                        <Button fx:id="annulerButton" onAction="#annuler" style="-fx-background-color: white; -fx-text-fill: #64748B; -fx-border-color: #CBD5E1; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 11 35; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand;" text="❌ Annuler" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>