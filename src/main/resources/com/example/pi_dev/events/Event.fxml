<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox style="-fx-background-color: #F1F5F9; -fx-padding: 0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pi_dev.Controllers.Events.EventController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: linear-gradient(to bottom right, #86A7BF, #2D70B3); -fx-padding: 20; -fx-spacing: 20;">
         <children>
            <ImageView fitHeight="50" fitWidth="50">
               <image>
                  <Image url="@../images/wanderlust-logo.png" />
               </image>
            </ImageView>
            <VBox spacing="5">
               <children>
                  <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Wanderlust" />
                  <Label style="-fx-font-size: 14px; -fx-text-fill: #CAD4DC;" text="Organiser un événement" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="15">
               <children>
                  <Button fx:id="adminDashboardButton" onAction="#ouvrirAdminApprovalDashboard" style="-fx-background-color: #111827; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-size: 13px; -fx-cursor: hand;" text="🛡️ Admin" />
               </children>
            </HBox>
         </children>
      </HBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox maxWidth="900" spacing="20" style="-fx-padding: 30;">
               <children>

                  <!-- Title -->
                  <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Créer un événement" />

                  <!-- Section: Lieu -->
                  <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Lieu" />
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <VBox spacing="8">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Lieu" />
                              <TextField fx:id="lieuField" promptText="Entrez une adresse..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8; -fx-font-style: italic;" text="Tapez l'adresse — la carte se positionnera automatiquement." />
                              <WebView fx:id="mapWebView" prefHeight="280" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Section: Dates et horaires -->
                  <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Dates et horaires" />
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <HBox spacing="20">
                           <children>
                              <VBox spacing="6" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Date et heure de début" />
                                    <DatePicker fx:id="dateDebutPicker" maxWidth="Infinity" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8;" />
                                    <TextField fx:id="heureDebutField" promptText="HH:mm (ex: 09:00)" maxWidth="200" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15; -fx-font-size: 13px;" />
                                 </children>
                              </VBox>
                              <VBox spacing="6" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Date et heure de fin" />
                                    <DatePicker fx:id="dateFinPicker" maxWidth="Infinity" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8;" />
                                    <TextField fx:id="heureFinField" promptText="HH:mm (ex: 18:00)" maxWidth="200" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15; -fx-font-size: 13px;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="6">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Date limite d'inscription" />
                              <DatePicker fx:id="dateLimitePicker" maxWidth="420" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Section: Activités associées -->
                  <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Activités associées" />
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <HBox alignment="CENTER_LEFT" spacing="15">
                           <children>
                              <ComboBox fx:id="activiteCombo" prefWidth="360" promptText="Sélectionnez une activité" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px;" />
                              <Button fx:id="ajouterActiviteButton" onAction="#ajouterActivite" style="-fx-background-color: #2D70B3; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 11 20; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Ajouter des activités" />
                           </children>
                        </HBox>
                        <VBox fx:id="activitesSelectionneesContainer" spacing="8" style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E2E8F0; -fx-border-width: 1; -fx-border-radius: 8;">
                           <children>
                              <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8; -fx-font-style: italic;" text="Aucune activité sélectionnée" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Section: Informations pratiques -->
                  <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Informations pratiques" />
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <HBox spacing="20">
                           <children>
                              <VBox spacing="6" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Prix (TND)" />
                                    <TextField fx:id="prixField" promptText="0.00" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                              <VBox spacing="6" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Capacité maximale" />
                                    <TextField fx:id="capaciteField" promptText="Nombre de places" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="6">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Organisateur" />
                              <TextField fx:id="nomorgField" promptText="Nom de l'organisateur" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                           </children>
                        </VBox>
                        <HBox spacing="20">
                           <children>
                              <VBox spacing="6" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Téléphone" />
                                    <TextField fx:id="telephoneorgField" promptText="+216 XX XXX XXX" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                              <VBox spacing="6" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Email" />
                                    <TextField fx:id="emailField" promptText="contact@exemple.com" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Section: Médias -->
                  <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Médias" />
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <VBox spacing="8">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Images" />
                              <VBox fx:id="imageDropZone" alignment="CENTER" spacing="10" onMouseClicked="#importerImages" style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-style: dashed; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 30; -fx-cursor: hand; -fx-background-radius: 10;">
                                 <children>
                                    <Label style="-fx-font-size: 32px;" text="🖼️" />
                                    <Label style="-fx-font-size: 14px; -fx-text-fill: #2D70B3; -fx-font-weight: bold;" text="Cliquez ou glissez vos images ici" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="JPG, PNG, WEBP — max 5 Mo par image" />
                                 </children>
                              </VBox>
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #2D70B3; -fx-font-style: italic;" text="Conseil : Vous pouvez sélectionner plusieurs images en même temps" />
                              <ScrollPane fx:id="photosScrollPane" fitToWidth="true" hbarPolicy="NEVER" managed="false" prefHeight="110" style="-fx-background-color: transparent; -fx-border-color: transparent;" visible="false">
                                 <content>
                                    <HBox fx:id="photosContainer" alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 5;" />
                                 </content>
                              </ScrollPane>
                           </children>
                        </VBox>
                        <VBox spacing="6">
                           <children>
                              <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Vidéo (optionnel)" />
                              <TextField fx:id="videoYoutubeField" promptText="https://youtube.com/..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14px;" />
                              <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="Lien YouTube, Vimeo... (optionnel)" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Section: Matériels nécessaires -->
                  <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Matériels nécessaires" />
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <TextArea fx:id="equipementField" prefHeight="120" promptText="Listez les matériels requis..." style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14px;" wrapText="true" />
                        <Button fx:id="genererEquipementBtn" onAction="#genererEquipement" style="-fx-background-color: linear-gradient(to right, #F59E0B, #D97706); -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 25; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(217,119,6,0.35), 8, 0, 0, 3);" text="✨ Générer les équipements avec l'IA" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" text="💡 Basé sur les activités sélectionnées ci-dessus" />
                     </children>
                  </VBox>

                  <!-- Section: Règles et conditions -->
                  <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 4);">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F2C4F;" text="Règles et conditions" />
                        <Separator style="-fx-background-color: #e2e8f0;" />
                        <VBox spacing="12">
                           <children>
                              <CheckBox fx:id="check1" style="-fx-font-size: 14px; -fx-text-fill: #334155;" text="Je m'engage à respecter les normes de sécurité" />
                              <CheckBox fx:id="check2" style="-fx-font-size: 14px; -fx-text-fill: #334155;" text="Je confirme être qualifié pour encadrer cet événement" />
                              <CheckBox fx:id="check3" style="-fx-font-size: 14px; -fx-text-fill: #334155;" text="J'accepte que Wanderlust vérifie les informations fournies" />
                              <CheckBox fx:id="check4" style="-fx-font-size: 14px; -fx-text-fill: #334155;" text="Je m'engage à informer les participants de tous les risques" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Buttons -->
                  <Button fx:id="ajouterEventButton" maxWidth="Infinity" onAction="#ajouterEvent" style="-fx-background-color: #2D70B3; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 16; -fx-font-size: 17px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(45,112,179,0.4), 10, 0, 0, 4);" text="Créer l'événement" />
                  <Button fx:id="annulerEventButton" maxWidth="Infinity" onAction="#annulerEvent" style="-fx-background-color: white; -fx-text-fill: #64748B; -fx-border-color: #CBD5E1; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14; -fx-font-size: 15px; -fx-cursor: hand;" text="❌ Annuler" />

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
