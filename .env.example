# ============================================================
# Wanderlust Java Project - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ==================== SYMFONY BACKEND ====================
# URL of the Symfony API backend for synchronization
SYMFONY_API_URL=http://localhost:8000

# JWT token for authentication with Symfony backend
SYMFONY_JWT_TOKEN=your_jwt_token_here

# ==================== AI/ML SERVICES ====================
# These are optional - if not set, fallback lexicon-based scoring is used

# Anomaly Detection API endpoint
# Can be hosted locally or use external service (e.g., HuggingFace Inference API)
ANOMALY_API_URL=http://localhost:5000/anomaly/score

# Message Toxicity Detection API endpoint
TOXICITY_API_URL=http://localhost:5001/toxicity/score

# Bot Behavior Detection API endpoint
BOT_BEHAVIOR_API_URL=http://localhost:5002/behavior/classify-human-bot

# ==================== FACE VERIFICATION ====================
# DeepFace API for face recognition
# Setup: Docker: docker run -p 5005:5005 serengil/deepface:latest
DEEPFACE_API_URL=http://localhost:5005

# ==================== SMS/WHATSAPP SERVICES (TWILIO) ====================
# Get these from https://www.twilio.com/console

# Your Twilio Account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Your Twilio Authentication Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio phone number for SMS (format: +1234567890)
TWILIO_PHONE_NUMBER=+1234567890

# Twilio WhatsApp number (format: +1234567890)
TWILIO_WHATSAPP_NUMBER=+1234567890

# ==================== EMAIL SERVICE ====================
# Configure SMTP for sending verification codes and notifications

# SMTP Server hostname
SMTP_HOST=smtp.gmail.com

# SMTP Port (typically 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USERNAME=your_email@gmail.com

# SMTP password or app-specific password
# For Gmail: Generate an app password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_password_here

# Sender email address
SENDER_EMAIL=noreply@wanderlust.com

# Sender display name
SENDER_NAME=Wanderlust

# ==================== FILE UPLOAD PATHS ====================
# Local directories for storing uploaded files

# Base upload directory
UPLOAD_DIR=./uploads/

# Profile pictures directory (relative to UPLOAD_DIR)
# Full path: UPLOAD_DIR/profiles/
# Example: ./uploads/profiles/

# Face verification images directory
# Full path: UPLOAD_DIR/faces/
# Example: ./uploads/faces/

# Testimonial images directory
# Full path: UPLOAD_DIR/testimonials/
# Example: ./uploads/testimonials/

# ==================== DATABASE ====================
# Database credentials (if different from default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wanderlust
DB_USER=root
DB_PASSWORD=

# ==================== APPLICATION ====================
# General application settings

# Environment: development, staging, production
APP_ENV=development

# Debug mode (true/false)
APP_DEBUG=true

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ==================== SECURITY ====================
# Security settings

# Enable face verification for login (true/false)
ENABLE_FACE_2FA=true

# Enable SMS/WhatsApp verification (true/false)
ENABLE_SMS_2FA=true

# Risk score threshold for CAPTCHA (0-100)
RISK_CAPTCHA_THRESHOLD=30

# Risk score threshold for temporary block (0-100)
RISK_BLOCK_THRESHOLD=70

# Risk score threshold for manual review (0-100)
RISK_MANUAL_REVIEW_THRESHOLD=85

# Session timeout in minutes
SESSION_TIMEOUT=30

# Password reset token expiry in minutes
PASSWORD_RESET_EXPIRY=60

# ==================== MONITORING ====================
# Monitoring and alerting settings

# Send risk alerts via email (true/false)
ALERT_HIGH_RISK_USERS=true

# Alert email recipient
ALERT_EMAIL_RECIPIENT=admin@wanderlust.com

# Enable detailed activity logging (true/false)
ENABLE_DETAILED_LOGGING=true

# Retention period for activity logs in days
ACTIVITY_LOG_RETENTION_DAYS=90

# ============================================================
# NOTES:
# ============================================================
# 1. Never commit .env file with real credentials to version control
# 2. Use strong, unique passwords for external services
# 3. For production, use secure credential management (AWS Secrets, HashiCorp Vault)
# 4. Test API endpoints before going to production
# 5. Keep these values synchronized between Java and Symfony projects
# ============================================================

